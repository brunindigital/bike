# Copy to .env and fill in real values. NEVER commit .env with real secrets.

# Supabase (public — safe on client)
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""

# Supabase server-side mirrors
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_PROJECT_ID=""

# Server-only — MUST NEVER be exposed to the frontend
SUPABASE_SERVICE_ROLE_KEY=""

# PIX gateway (ClownPay) — server-only. Gateway ativa do projeto.
CLOWNPAY_API_KEY=""
# Alias aceito para instalações que chamam a chave de secret key.
CLOWNPAY_SECRET_KEY=""
# Chave separada para as páginas /upsell1 até /upsell4.
CLOWNPAY_UPSELL_API_KEY=""
CLOWNPAY_UPSELL_SECRET_KEY=""

# Gateway anterior (mantido como referência para rollback)
FLEVOPAY_API_KEY=""
# Opcional: hash do produto cadastrado no painel (sem ele usamos source=api_externa)
FLEVOPAY_PRODUCT_HASH=""

# API do site de rastreio (server-only)
PEDIDOS_API_KEY=""

# Utmify — token server-only usado para enviar pedidos e conversões.
UTMIFY_API_TOKEN=""